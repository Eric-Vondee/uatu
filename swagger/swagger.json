                "message": {
                    "type": "string"
                }
            }
        },
        "uatu.Actions": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "string"
                },
                "chainId": {
                    "type": "integer"
                },
                "data": {
                    "type": "string"
                },
                "from": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "spender": {
                    "type": "string"
                },
                "to": {
                    "type": "string"
                }
            }
        },
        "uatu.Chain": {
            "type": "object",
            "properties": {
                "blockChainLogo": {
                    "type": "string"
                },
                "blockExplorer": {
                    "type": "string"
                },
                "chainId": {
                    "type": "integer"
                },
                "dex": {
                    "type": "array",
