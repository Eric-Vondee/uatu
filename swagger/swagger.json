                "name": {
                    "type": "string"
                },
                "permit2Address": {
                    "type": "string"
                },
                "settlementAddress": {
                    "type": "string"
                },
                "slug": {
                    "type": "string"
                },
                "universalRouterAddress": {
                    "type": "string"
                },
                "v2FactoryAddress": {
                    "type": "string"
                },
                "v2RouterAddress": {
                    "type": "string"
                },
                "v3FactoryAddress": {
                    "type": "string"
                },
                "v3QuoterAddress": {
                    "type": "string"
                },
                "v3RouterAddress": {
                    "type": "string"
                },
                "version": {
