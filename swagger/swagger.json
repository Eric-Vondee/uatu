                    "type": "string"
                },
                "dexName": {
                    "type": "string"
                },
                "isActivePool": {
                    "type": "boolean"
                },
                "liquidity": {
                    "$ref": "#/definitions/uatu.PoolLiquidity"
                },
                "liquidityInUsd": {
                    "$ref": "#/definitions/uatu.PoolLiquidityUSD"
                },
                "marketCap": {
                    "type": "string"
                },
